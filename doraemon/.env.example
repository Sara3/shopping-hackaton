# Copy to .env and fill in. Never commit the real .env (see agent_constitution.md).

# --- Model (Amazon Bedrock -- the only supported model host) ---
# Uses your normal AWS credential chain (env vars, `aws configure`, or an IAM role) --
# no key goes in this file.
# Leave STRANDS_MODEL_ID unset to use the default in agent/config.py (a cross-region
# inference profile id); override it if that's not enabled in your account/region.
STRANDS_MODEL_ID=
AWS_REGION=us-east-1

# --- Arcade ---
# "mock" is the only implemented value right now -- Arcade's live API isn't wired up yet
# (see arcade-api-notes.md). ARCADE_API_KEY/ARCADE_API_BASE_URL are kept here as placeholders
# for when a LiveArcadeClient lands; they do nothing today.
ARCADE_MODE=mock
ARCADE_API_KEY=
ARCADE_API_BASE_URL=https://platform.arcade.ai/v1

# --- Leash gateway (shopping-hackaton repo, gateway/) ---
# Off by default: every tool call resolves in-process (MockArcadeClient). Set to true to send
# every Arcade call through the Leash gateway instead (agent/arcade_client.py's
# ProxiedArcadeClient): POST /arcade/<procedure> with a short-lived leash_ token, and a
# checkout as POST /mandates then POST /checkout. The gateway holds the Arcade key; this agent
# never does. get_order is not offered in this mode (orders:get is never issued to agents).
# Start the gateway from the repo root with the same admin key as below, e.g.
#   LEASH_ADMIN_KEY=<the key below> npm run demo:leash
# Without it, demo:leash generates a fresh admin key every run and this agent cannot mint.
USE_LEASH_PROXY=false
LEASH_PROXY_URL=http://127.0.0.1:8080
# The gateway's admin key (16+ characters, e.g. `openssl rand -hex 24`). Sent as Bearer on
# POST /tokens only, never on Arcade calls.
LEASH_ADMIN_KEY=
# Optional: pin a hand-minted token (e.g. to test a specific scope/denial case). Leave blank
# and ProxiedArcadeClient mints its own via POST /tokens, re-minting when its own clock says
# the token is about to expire, or once when the gateway answers 401 or "expired". It never
# re-mints after token_frozen, scope_denied or velocity_exceeded: a frozen agent stays frozen
# until a human restarts it or starts a new session. Agent tokens never carry checkouts:create.
LEASH_TOKEN=
# Params for that self-minted token (POST /tokens: agentId, payer, maxSpend, categories,
# ttlSeconds). Categories are Arcade category ids or exact names; the default is the
# replica's four mock categories. Narrow it (e.g. to "Silk scarf") to watch the gateway
# refuse the others with 403 scope_denied, which also freezes the token.
LEASH_AGENT_ID=agent_doraemon
LEASH_PAYER=demo-user
LEASH_MAX_SPEND_CENTS=15000
LEASH_CATEGORIES="Silk scarf,Linen pillow,Cotton dinner napkins,Lampshade"
LEASH_TOKEN_TTL_SECONDS=600

# --- Safety gates (agent_constitution.md Section 2) ---
# Default on. Flipping this off is the explicit, human action that lets create_checkout
# make a real (mocked, for now) Arcade call instead of fabricating a receipt.
DRY_RUN_CHECKOUT=true
# Orders above this total require a separate override confirmation.
ORDER_SPEND_CEILING_CENTS=10000

# --- Local tracing (debugging only, see RUNNING.md) ---
# Off by default. Set to true only after `docker compose up -d` (starts a local Jaeger),
# otherwise span export just fails silently in the background.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Also print spans to stdout as they're created, in addition to exporting to Jaeger.
ENABLE_CONSOLE_TRACING=false
