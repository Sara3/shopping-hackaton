# Create a key at https://studio.arcade.ai/settings/api-keys (Settings → API keys)
ARCADE_API_KEY=
# Required by Arcade's edge: name your app + a contact, or you get a non-JSON 403
ARCADE_USER_AGENT=shopping-hackaton/0.1 (support@withsavvy.ai)
# Optional: pin a category for `npm run smoke` (ids come from `npm run categories`)
ARCADE_CATEGORY_ID=

# Leash gateway (optional). With LEASH_URL set the agent gets a scoped token instead of the Arcade key,
# and `npm run demo` starts the gateway on that port when the URL is local (`npm run gateway` alone).
# LEASH_URL=http://127.0.0.1:8080
# Signs tokens and mandates; empty = random per start (tokens do not survive a restart). Never commit it.
# LEASH_SECRET=
# Guards POST /tokens, GET /tokens/<id> and GET /ledger (16+ characters). `npm run demo` generates one per run
# when empty; `npm run gateway` refuses to start without it (the web process reads the same value). Never commit it.
# LEASH_ADMIN_KEY=
# Pre-saves an allowance at start: the web agent's token may spend this much, on these categories (ids or
# names, comma separated; empty = demo set). Unset: the agent stays the naive one (account key) until you
# save an allowance in the chat's Settings (`npm run demo:allowance` starts that way).
# LEASH_MAX_SPEND=200.00
# LEASH_CATEGORIES=

# Extra origins the agent may browse (comma separated; the replica is always allowed), e.g. the public copy of the listing:
# BROWSE_ORIGINS=https://sara3.github.io
# Path every page on those origins must start with (default /odette-atelier/):
# BROWSE_PATH_PREFIX=/odette-atelier/
