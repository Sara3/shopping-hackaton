# Copy to .env and fill in. Never commit the real .env (see agent_constitution.md).

# --- Model (Amazon Bedrock -- the only supported model host) ---
# Uses your normal AWS credential chain (env vars, `aws configure`, or an IAM role) --
# no key goes in this file.
# Leave STRANDS_MODEL_ID unset to use the default in agent/config.py (a cross-region
# inference profile id); override it if that's not enabled in your account/region.
STRANDS_MODEL_ID=
AWS_REGION=us-east-1

# --- Arcade ---
# "mock" is the only implemented value right now -- Arcade's live API isn't wired up yet
# (see arcade-api-notes.md). ARCADE_API_KEY/ARCADE_API_BASE_URL are kept here as placeholders
# for when a LiveArcadeClient lands; they do nothing today.
ARCADE_MODE=mock
ARCADE_API_KEY=
ARCADE_API_BASE_URL=https://platform.arcade.ai/v1

# --- Safety gates (agent_constitution.md Section 2) ---
# Default on. Flipping this off is the explicit, human action that lets create_checkout
# make a real (mocked, for now) Arcade call instead of fabricating a receipt.
DRY_RUN_CHECKOUT=true
# Orders above this total require a separate override confirmation.
ORDER_SPEND_CEILING_CENTS=10000

# --- Local tracing (debugging only, see RUNNING.md) ---
# Off by default. Set to true only after `docker compose up -d` (starts a local Jaeger),
# otherwise span export just fails silently in the background.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Also print spans to stdout as they're created, in addition to exporting to Jaeger.
ENABLE_CONSOLE_TRACING=false
