# Create a key at https://studio.arcade.ai/settings/api-keys (Settings → API keys)
ARCADE_API_KEY=
# Required by Arcade's edge: name your app + a contact, or you get a non-JSON 403
ARCADE_USER_AGENT=shopping-hackaton/0.1 (support@withsavvy.ai)
# Optional: pin a category for `npm run smoke` (ids come from `npm run categories`)
ARCADE_CATEGORY_ID=

# Leash gateway (optional). With LEASH_URL set the agent gets a scoped token instead of the Arcade key,
# and `npm run demo` starts the gateway on that port when the URL is local (`npm run gateway` alone).
# LEASH_URL=http://127.0.0.1:8080
# Signs tokens and mandates; empty = random per start (tokens do not survive a restart). Never commit it.
# LEASH_SECRET=
# Guards POST /tokens, GET /tokens/<id> and GET /ledger (16+ characters). `npm run demo` generates one per run
# when empty; `npm run gateway` refuses to start without it (the web process reads the same value). Never commit it.
# LEASH_ADMIN_KEY=
# Pre-saves an allowance at start: the web agent's token may spend this much, on these categories (ids or
# names, comma separated; empty = demo set). Unset: the agent stays the naive one (account key) until you
# save an allowance in the chat's Settings (`npm run demo:allowance` starts that way).
# LEASH_MAX_SPEND=200.00
# LEASH_CATEGORIES=

# Which agent answers the chat: doraemon (the npm demo scripts set it; runs only behind Leash, see
# doraemon/agent/service.py) or naive (agent/naive-agent.mjs, the red-team target; also the default when unset).
# AGENT_BACKEND=doraemon
# Doraemon's service: port 8790; `npm run demo` generates the shared DORAEMON_SERVICE_KEY per run.
# DORAEMON_PORT=8790
# (OTEL_ENABLED below also turns on Doraemon's traces: `npm run demo` passes it to the Doraemon service.)

# Claude for the naive agent (agent/naive-agent.mjs, `npm run demo:allowance`): with a key here the chat is answered
# by Claude (model AGENT_MODEL, default claude-opus-5-5, strict tools); without one a deterministic scripted stand-in
# answers. AGENT_MODE=scripted|llm forces either. Check: GET /api/config shows agentMode. Never commit the key.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# Extra origins the agent may browse (comma separated; the replica is always allowed), e.g. the public copy of the listing:
# BROWSE_ORIGINS=https://sara3.github.io
# Path every page on those origins must start with (default /odette-atelier/):
# BROWSE_PATH_PREFIX=/odette-atelier/

# Last-line guard in front of a real Arcade order (gateway/checkout.mjs): with ARCADE_MODE=live and this
# false, every mandate, price and design check still runs, but the checkout is simulated: no Arcade order,
# nothing charged; the link opens the gateway's own checkout page at /simulated-checkout/<mandateId>, whose
# Pay button confirms a simulated order, and the allowance counts it. No effect in mock mode. Leave false unless a human has explicitly approved a real order.
LIVE_CHECKOUT_ENABLED=false
# OTel spans exported to a local Jaeger over OTLP HTTP: the gateway's (token.issue, mandate.create, checkout,
# arcade.call; service leash-gateway) and Doraemon's (agent.turn, model and tool calls; service doraemon).
# Off by default. Set to true only after `docker compose up -d` (starts Jaeger; UI on :16686).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
